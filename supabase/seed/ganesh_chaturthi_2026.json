  "prasadam": [
    {
      "id": "ukadiche-modak",
      "name": {
        "en": "Ukadiche Modak (steamed rice modak)",
        "te": "ఉడికించిన మోదకం"
      },
      "type": "sweet",
      "serves": "makes ~21",
      "ingredients": [
        {
          "item": {
            "en": "Rice flour",
            "te": "బియ్యప్పిండి"
          },
          "quantity": "1 cup"
        },
        {
          "item": {
            "en": "Grated coconut",
            "te": "కొబ్బరి తురుము"
          },
          "quantity": "1 cup"
        },
        {
          "item": {
            "en": "Jaggery",
            "te": "బెల్లం"
          },
          "quantity": "3/4 cup"
        },
        {
          "item": {
            "en": "Cardamom, ghee, pinch of salt",
            "te": "యాలకులు, నెయ్యి, ఉప్పు"
          },
          "quantity": "to taste"
        }
      ],
      "steps": [
        {
          "en": "Cook coconut and jaggery with cardamom into a soft filling (puran); cool."
        },
        {
          "en": "Bring water with ghee and salt to a boil, add rice flour, stir to a soft dough; knead while warm."
        },
        {
          "en": "Shape small cups, fill with the coconut-jaggery mixture, and pleat closed into a modak."
        },
        {
          "en": "Steam 10-12 minutes; offer warm with a drizzle of ghee."
        }
      ],
      "offering_note": {
        "en": "Ganesha's most beloved offering."
      }
    },
    {
