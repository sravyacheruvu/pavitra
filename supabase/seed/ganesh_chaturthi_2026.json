        },
        {
          "order": 5,
          "title": {
            "en": "Vrata Katha & Aarti",
            "te": "వ్రత కథ & హారతి"
          },
          "instruction": {
            "en": "Read the Vinayaka Vrata Katha (Syamantaka story), offer camphor aarti, and distribute prasadam.",
            "te": "వినాయక వ్రత కథ చదివి, హారతి ఇచ్చి ప్రసాదం పంచండి."
          }
        }
      ]
    },
