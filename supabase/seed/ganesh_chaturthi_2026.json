      },
      "steps": [
        {
          "order": 1,
          "title": {
            "en": "Sankalpam",
            "te": "సంకల్పం"
          },
          "instruction": {
            "en": "Bathe, install the idol on the cloth-covered plank facing east or north, light the lamp, and take the sankalpa.",
            "te": "స్నానం చేసి, విగ్రహాన్ని ప్రతిష్టించి, దీపం వెలిగించి సంకల్పం చెప్పుకోండి."
          }
        },
        {
          "order": 2,
          "title": {
            "en": "Prana Pratishtha",
            "te": "ప్రాణ ప్రతిష్ఠ"
          },
          "instruction": {
            "en": "Invoke the presence of Ganesha into the idol with akshata and the mula mantra.",
            "te": "అక్షతలతో వినాయకుని ఆవాహన చేయండి."
          },
          "mantra": {
            "sa": "ॐ गं गणपतये नमः",
            "transliteration": "Om Gam Ganapataye Namaha",
            "meaning": {
              "en": "Salutations to Lord Ganesha."
            }
          }
        },
        {
          "order": 3,
          "title": {
            "en": "Shatpachara Puja",
            "te": "పంచోపచార పూజ"
          },
          "instruction": {
            "en": "Offer gandha, akshata, red flowers, durva, dhupa and deepa while chanting the name.",
            "te": "గంధం, అక్షతలు, ఎర్రపూలు, గరిక, ధూప దీపాలు సమర్పించండి."
          }
        },
        {
          "order": 4,
          "title": {
            "en": "Durva & Modak Naivedya",
            "te": "గరిక, మోదక నైవేద్యం"
          },
          "instruction": {
            "en": "Offer 21 durva blades and 21 modak, then fruits.",
            "te": "21 గరికలు, 21 మోదకాలు, పండ్లు సమర్పించండి."
